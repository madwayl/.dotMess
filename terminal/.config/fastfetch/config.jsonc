{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/source.txt",
    "padding": {
      "top": 1,
      "left": 4,
      "right": 5
    },
    "position": "left",
    "preserveAspectRatio": true,
    "printRemaining": true,
    "color": {
      "1": "black",
      "2": "magenta"
    },
    "chafa": {
      "symbols": "block",
      "canvasMode": "TRUECOLOR",
      "colorSpace": "RGB",
      "ditherMode": "DIFFUSION"
    }
  },
  "display": {
    "separator": "  "
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒ Hardware ▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒"
    },
    "break",
    {
      "type": "host",
      "key": "  PC",
      "keyColor": "green"
    },
    {
      "type": "cpu",
      "key": " │ ├",
      "showPeCoreCount": true,
      "keyColor": "green"
    },
    {
      "type": "gpu",
      "key": " │ ├󰍛",
      "keyColor": "green"
    },
    {
      "type": "memory",
      "key": " │ ├󰍛",
      "keyColor": "green"
    },
    {
      "type": "disk",
      "key": " └ └",
      "keyColor": "green"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒ Software ▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒"
    },
    "break",
    {
      "type": "os",
      "key": "  OS",
      "keyColor": "yellow"
    },
    {
      "type": "kernel",
      "key": " │ ├",
      "keyColor": "yellow"
    },
    {
      "type": "packages",
      "key": " │ ├󰏖",
      "keyColor": "yellow"
    },
    {
      "type": "shell",
      "key": " │ ├",
      "keyColor": "yellow"
    },
    {
      "type": "lm",
      "key": " │ ├",
      "keyColor": "blue"
    },
    {
      "type": "wm",
      "key": " │ ├",
      "keyColor": "blue"
    },
    {
      "type": "wmtheme",
      "key": " │ ├󰉼",
      "keyColor": "blue"
    },
    {
      "type": "gpu",
      "key": " └ └󰍛",
      "format": "{3}",
      "keyColor": "blue"
    },
    "break"
  ]
}