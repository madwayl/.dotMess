.notification-row .notification-background .notification .notification-action {
    /* CHANGE HERE */
    background: @{{ (ds "data").color }};
    background: linear-gradient(60deg, @o-{{ (ds "data").color }} 0%, @{{ (ds "data").color }} 80%);
}

.notification-background .notification.normal,
.notification-background .notification.low {
    /* CHANGE HERE */
    background: @{{ (ds "data").bg_color }};
    background: @bg0;
}

.widget-dnd>switch:checked {
    /* CHANGE HERE */
    background: @{{ (ds "data").color }};
    /* CHANGE HERE */
    border: 1px solid @{{ (ds "data").color }};
}

.widget-buttons-grid>flowbox>flowboxchild>button:checked {
    /* CHANGE HERE */
    background: linear-gradient(60deg, @o-{{ (ds "data").color }} 0%, @{{ (ds "data").color }} 80%);
}

.widget-buttons-grid>flowbox>flowboxchild>button:checked:hover {
    /* CHANGE HERE */
    background: linear-gradient(120deg, @o-{{ (ds "data").color }} 0%, @{{ (ds "data").color }} 80%);
}
.widget-backlight highlight,
.widget-volume highlight {
    /* CHANGE HERE */
    background: linear-gradient(60deg, @o-{{ (ds "data").color }} 0%, @{{ (ds "data").color }} 80%);
}

.widget-backlight trough slider,
.widget-volume trough slider {
    /* CHANGE HERE */
    color: @{{ (ds "data").color }};
}