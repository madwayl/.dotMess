; https://github.com/uiriansan/SilentSDDM/wiki/Customizing

[General]
scale = 1.25
enable-animations = true
animated-background-placeholder = ""
background-fill-mode = fill

[LockScreen]
display = true
padding-top = 0
padding-right = 0
padding-bottom = 0
padding-left = 0
background = default.png
use-background-color = false
background-color = #181818
blur = 42
brightness = -0.1
saturation = 0.2

[LockScreen.Clock]
display = true
position = top-center
align = center
format = hh:mm
font-family = "0xProto Nerd Font Propo"
font-size = 170
font-weight = 900
color = {{ (ds "data").sddm_color }}

[LockScreen.Date]
display = true
format = dddd, MMMM dd, yyyy
locale = "en_US"
font-family = "0xProto Nerd Font Propo"
font-size = 22
font-weight = 600
color = #e2cca9
margin-top = -15

[LockScreen.Message]
display = true
position = bottom-center
align = center
text = 
font-family = "0xProto Nerd Font Propo"
font-size = 12
font-weight = 500
display-icon = true
icon = enter.svg
icon-size = 18
color = {{ (ds "data").sddm_color }}
paint-icon = true
spacing = 15

[LoginScreen]
background = default.png
use-background-color = false
background-color = #181818
blur = 24
brightness = -0.15
saturation = 0.0

[LoginScreen.LoginArea]
position = center
margin = -1

[LoginScreen.LoginArea.Avatar]
shape = circle
border-radius = 6
active-size = 120
inactive-size = 80
inactive-opacity = 0.15
active-border-size = 0
inactive-border-size = 0
active-border-color = #e2cca9
inactive-border-color = #e2cca9

[LoginScreen.LoginArea.Username]
font-family = "0xProto Nerd Font Propo"
font-size = 12
font-weight = 700
color = #e2cca9
margin = 10

[LoginScreen.LoginArea.PasswordInput]
width = 200
height = 30
display-icon = true
font-family = "0xProto Nerd Font Propo"
font-size = 9
icon = password.svg
icon-size = 16
content-color = #e2cca9
background-color = #e2cca9
background-opacity = 0.25
border-size = 0
border-color = #e2cca9
border-radius-left = 6
border-radius-right = 6
margin-top = 10

[LoginScreen.LoginArea.LoginButton]
background-color = #e2cca9
background-opacity = 0.25
active-background-color = #e2cca9
active-background-opacity = 0.30
icon = arrow-right.svg
icon-size = 18
content-color = #e2cca9
active-content-color = {{ (ds "data").sddm_color }}
border-size = 0
border-color = #e2cca9
border-radius-left = 6
border-radius-right = 6
margin-left = 5
show-text-if-no-password = true
hide-if-not-needed = false
font-family = "0xProto Nerd Font Propo"
font-size = 9
font-weight = 600

[LoginScreen.LoginArea.Spinner]
display-text = true
text = "Logging in"
font-family = "0xProto Nerd Font Propo"
font-weight = 600
font-size = 12
icon-size = 30
icon = spinner.svg
color = {{ (ds "data").sddm_color }}
spacing = 5

[LoginScreen.LoginArea.WarningMessage]
font-family = "0xProto Nerd Font Propo"
font-size = 9
font-weight = 400
normal-color = #e2cca9
warning-color = #997c28
error-color = #992e28
margin-top = 10

[LoginScreen.MenuArea.Buttons]
margin-top = 50
margin-right = 50
margin-bottom = 50
margin-left = 50
size = 30
border-radius = 5
spacing = 10
font-family = "0xProto Nerd Font Propo"

[LoginScreen.MenuArea.Popups]
max-height = 300
item-height = 30
item-spacing = 2
padding = 5
display-scrollbar = true
margin = 5
background-color = {{ (ds "data").sddm_bg_color }}
background-opacity = 0.15
active-option-background-color = {{ (ds "data").sddm_bg_color }}
active-option-background-opacity = 0.30
content-color = #e2cca9
active-content-color = {{ (ds "data").sddm_color }}
font-family = "0xProto Nerd Font Propo"
border-size = 0
border-color = #e2cca9
font-size = 9
icon-size = 16

[LoginScreen.MenuArea.Session]
display = true
position = bottom-left
index = 0
popup-direction = up
popup-align = center
display-session-name = true
button-width = 200
popup-width = 200
background-color = {{ (ds "data").sddm_bg_color }}
background-opacity = 0.0
active-background-opacity = 0.30
content-color = #e2cca9
active-content-color = {{ (ds "data").sddm_color }}
border-size = 0
font-size = 9
icon-size = 16

[LoginScreen.MenuArea.Layout]
display = true
position = bottom-right
index = 0
popup-direction = up
popup-align = center
popup-width = 180
display-layout-name = true
background-color = #3f3518
background-opacity = 0.0
active-background-opacity = 0.30
content-color = #e2cca9
active-content-color = {{ (ds "data").sddm_color }}
border-size = 0
font-size = 9
icon = language.svg
icon-size = 16

[LoginScreen.MenuArea.Keyboard]
display = true
position = bottom-right
index = 0
background-color = {{ (ds "data").sddm_bg_color }}
background-opacity = 0.0
active-background-opacity = 0.30
content-color = #e2cca9
active-content-color = #e2cca9
border-size = 0
icon = keyboard.svg
icon-size = 16

[LoginScreen.MenuArea.Power]
display = true
position = bottom-right
index = 0
popup-direction = up
popup-align = center
popup-width = 100
background-color = {{ (ds "data").sddm_bg_color }}
background-opacity = 0.0
active-background-opacity = 0.30
content-color = #e2cca9
active-content-color = {{ (ds "data").sddm_color }}
border-size = 0
icon = power.svg
icon-size = 16

[LoginScreen.VirtualKeyboard]
scale = 1.0
position = login
start-hidden = true
background-color = #e2cca9
background-opacity = 0.15
key-content-color = #e2cca9
key-color = #e2cca9
key-opacity = 0.15
key-active-background-color = {{ (ds "data").sddm_bg_color }}
key-active-opacity = 0.30
selection-background-color = #CCCCCC
selection-content-color = {{ (ds "data").sddm_color }}
primary-color = #FFF
border-size = 0
border-color = #181818

[Tooltips]
enable = true
font-family = "0xProto Nerd Font Propo"
font-size = 9
content-color = #e2cca9
background-color = #e2cca9
background-opacity = 0.15
border-radius = 5
disable-user = false
disable-login-button = false
