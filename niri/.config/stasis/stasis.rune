@author "Dustin Pilgrim"
@description "Stasis configuration file"

app_default_timeout 300

idle:
    respect_idle_inhibitors true
    monitor_media true

    inhibit_apps [
        "vlc"
        "Spotify"
        "mpv"
        r".*\.exe"
        r"steam_app_.*"
        r"firefox.*"
    ]

    # Laptop-only AC actions
    on_ac:

        lock_screen:
            command "hyprlock"
            timeout 300
        end

        dpms:
            command "niri msg action power-off-monitors"
            timeout 400
        end

        suspend:
            command "systemctl suspend"
            timeout 1800
        end

    end

    # Laptop-only battery actions
    on_battery:

        lock_screen:
            command "hyprlock"
            timeout 300
        end

        dpms:
            command "niri msg action power-off-monitors"
            timeout 400
        end

        suspend:
            command "systemctl suspend"
            timeout 1200
        end

    end
end