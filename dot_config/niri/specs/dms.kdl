// spawn-at-startup "dms" "run"

// SECTION Layer Rules

// Make top and overlay layers use the regular blur (if enabled),
// while bottom and background layers keep using the efficient xray blur.
layer-rule {
    match layer="top"
    match layer="overlay"

    background-effect {
        xray false
        blur true
    }
}

layer-rule {
    match namespace=r#"^dms:.*"#

    background-effect {
        xray false
        blur false
        // noise 0.000001
        // saturation 1.02
    }
}

layer-rule {
    match namespace="^dms-clipboardPlus-panel"

    // opacity 0.85

    background-effect {
        blur true
        xray false
        noise 0.00000000001
        saturation 1.02
    }

}

layer-rule {
    // match namespace="^dms:dock"
    match namespace="^dms:bar"
    // match namespace="^dms:control-center"

    match namespace="dms:notification-popup"
    match namespace="^dms:popout"
    match namespace="^dms:plugins:fullscreenPowerMenu"

    // opacity 0.5

    background-effect {
        blur true
        xray false
        noise 0.000001
        saturation 1.2
    }

    geometry-corner-radius 6
    // place-within-backdrop true
    // baba-is-float true

}


layer-rule {
    match namespace="^quickshell$"
    place-within-backdrop false
}

layer-rule {
    match namespace="dms:blurwallpaper"
    place-within-backdrop true
}

layer-rule {
    match namespace="dms:notification-popup"
    match namespace="^dms:clipboard$"
    match namespace="^dms-clipboardPlus-panel"

    block-out-from "screencast"
}

layer-rule {
    match namespace="^dms:spotlight$"
    shadow {
        on
        softness 40
        spread 4
        offset x=5 y=5
    }
    geometry-corner-radius 6
}

// !SECTION

// Optional: Clipboard history
spawn-at-startup "bash" "-c" "wl-paste --watch cliphist store &"

binds {

    Mod+Space repeat=false {
        spawn "dms" "ipc" "call" "launcher" "toggle";
    }

    Mod+Alt+V hotkey-overlay-title="Clipboard Manager" {
        spawn "dms" "ipc" "call" "clipboardPlus" "togglePanel"
    }

    Mod+Ctrl+V hotkey-overlay-title="Add Clipboard to Note Card" {
        spawn-sh "dms ipc call clipboardPlus addClipboardToNoteCard"
    }

    Super+Alt+Period repeat=false hotkey-overlay-title="Open Emoji Picker" {
        spawn "dms" "ipc" "call" "launcher" "toggleQuery" ":e";
    }

    Mod+M hotkey-overlay-title="Task Manager" {
        spawn "dms" "ipc" "call" "processlist" "toggle";
    }
    Mod+Comma hotkey-overlay-title="Settings" {
        spawn "dms" "ipc" "call" "settings" "toggle";
    }
    Mod+N hotkey-overlay-title="Notification Center" {
        spawn "dms" "ipc" "call" "notifications" "toggle";
    }

    // Security
    Mod+Alt+L hotkey-overlay-title="Lock Screen" {
        spawn "dms" "ipc" "call" "lock" "lock";
    }
    Mod+Escape hotkey-overlay-title="Power Toggle" {
        spawn "dms" "ipc" "call" "powermenu" "toggle"
    }

    // Audio Controls
    XF86AudioRaiseVolume allow-when-locked=true {
        spawn "dms" "ipc" "call" "audio" "increment" "3";
    }
    XF86AudioLowerVolume allow-when-locked=true {
        spawn "dms" "ipc" "call" "audio" "decrement" "3";
    }
    XF86AudioMute allow-when-locked=true {
        spawn "dms" "ipc" "call" "audio" "mute";
    }
    XF86AudioMicMute allow-when-locked=true {
        spawn "dms" "ipc" "call" "audio" "micmute";
    }

    // Brightness Controls
    XF86MonBrightnessUp allow-when-locked=true {
        spawn "dms" "ipc" "call" "brightness" "increment" "5" "";
    }
    XF86MonBrightnessDown allow-when-locked=true {
        spawn "dms" "ipc" "call" "brightness" "decrement" "5" "";
    }

    // DMS Specific Applications
    Mod+Shift+C { spawn "dms" "color" "pick" "-a"; }
    Mod+Shift+N { spawn "dms" "ipc" "call" "notepad" "toggle"; }

}

environment {
    DMS_SCREENSHOT_EDITOR "ksnip"
    DMS_MODAL_LAYER "overlay"
    }

switch-events {
    lid-close {spawn "dms" "ipc" "call" "lock" "lock";}
}


include "../dms/colors.kdl"
include "../dms/alttab.kdl"
include "../dms/cursor.kdl"
include "../dms/outputs.kdl"
