# This is the configuration file for Ghostty.
#
# Run `ghostty +show-config --default --docs` to view a list of
# all available config options and their default values.
#
# Additionally, each config option is also explained in detail
# on Ghostty's website, at https://ghostty.org/docs/config.
#
# Ghostty can reload the configuration while running by using the menu
# options or the bound key (default: Command + Shift + comma on macOS and
# Control + Shift + comma on other platforms). Not all config options can be
# reloaded while running; some only apply to new windows and others may require
# a full restart to take effect.

font-family = "Maple Mono"
window-title-font-family = "Maple Mono"
font-size = 10.25

# adjust-font-baseline = 2

adjust-icon-height = 10
adjust-cell-height = 5
adjust-cell-width = 0

background-opacity = 0.7

cursor-style = block_hollow
mouse-shift-capture = true

clipboard-trim-trailing-spaces = true
clipboard-write = allow

window-padding-x = 20
window-padding-y = 25,10
window-padding-balance = true

custom-shader-animation = true
desktop-notifications = true
confirm-close-surface = false

shell-integration = detect
shell-integration-features = cursor,sudo,no-title

split-divider-color =
term = xterm-ghostty

unfocused-split-fill =
unfocused-split-opacity = 0.5

vt-kam-allowed = false
wait-after-command = false

window-colorspace = srgb
window-decoration = auto
window-inherit-working-directory = true
window-theme = auto
window-save-state = always

bell-features = no-title

gtk-toolbar-style = raised
gtk-titlebar-style = native
# gtk-single-instance = true
# linux-cgroup = single-instance

auto-update = off

config-file = ./matugen
gtk-custom-css = ./matugen-theme.css
app-notifications = no-clipboard-copy,no-config-reload
theme = dankcolors
