[calendars]

[[private]]
path = /home/MaWe/.local/share/khal/calendars/private/{{ (rbw "Google").data.username }}
type = calendar

[[holiday]]
path = /home/MaWe/.local/share/khal/calendars/holidays
type = calendar

[locale]
timeformat = %H:%M
dateformat = %Y-%m-%d
longdateformat = %Y-%m-%d
datetimeformat = %Y-%m-%d %H:%M
longdatetimeformat = %Y-%m-%d %H:%M

[default]
default_calendar = private
