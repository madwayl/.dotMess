{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "~/Pictures/wallpaper-square.png",
    "padding": {
      "top": 1,
      "left": 1,
      "right": 4,
    },
    "width": 30,
    "position": "left",
  },
  "display": {
    "separator": " ",
    "color": {
      "keys": "{{colors.primary.default.hex}}",
      "title": "{{colors.secondary.default.hex}}",
    },
  },
  "modules": [
    {
      "type": "custom",
      "format": "\n\n",
    },
    "os",
    "kernel",
    "memory",
    "packages",
    "uptime",
    {
      "type": "colors",
      "key": "Colors",
    },
  ],
}
