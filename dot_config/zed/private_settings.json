// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "agent": {
    "default_profile": "ask",
    "default_model": {
      "provider": "lmstudio",
      "model": "qwen/qwen3-4b-thinking-2507"
    },
    "model_parameters": []
  },
  "theme": {
    "mode": "system",
    "light": "Matugen Light",
    "dark": "Matugen Dark"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "lsp_document_colors": "background",
  "indent_guides": {
    "background_coloring": "indent_aware",
    "coloring": "indent_aware"
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "vim_mode": true,
  "relative_line_numbers": "enabled",
  "prettier": {
    "allowed": true
  },
  "autosave": "on_focus_change",
  "cursor_shape": "bar",
  "icon_theme": {
    "mode": "system",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "git": {
    "git_gutter": "tracked_files",
    "inline_blame": {
      "enabled": false,
      "show_commit_summary": false
    }
  },
  "git_panel": {
    "sort_by_path": true,
    "button": true
  },
  "terminal": {
    "font_family": "Google Sans Code NF",
    "cursor_shape": "hollow",
    "toolbar": {
      "breadcrumbs": false
    },
    "dock": "bottom"
  },
  "project_panel": {
    "hide_root": true,
    "hide_gitignore": false
  },
  "active_pane_modifiers": {
    "border_size": 0.0
  },
  "use_system_window_tabs": true,
  "preview_tabs": {
    "enable_preview_from_code_navigation": true,
    "enable_preview_from_file_finder": true
  },
  "tabs": {
    "file_icons": true,
    "git_status": false
  },
  "tab_bar": {
    "show": true
  },
  "title_bar": {
    "show_menus": false,
    "show_branch_icon": true
  },
  "ui_font_size": 14,
  "buffer_font_size": 13,
  "buffer_font_family": "Google Sans Code NF",
  "buffer_font_weight": 400,
  "buffer_line_height": "comfortable",
  "ui_font_family": "Google Sans Code NF",
  "ui_font_weight": 400,
  "ui_font_features": {
    "calt": false
  }
}
